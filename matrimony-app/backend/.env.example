# Copy to .env and fill in. NEVER commit .env.
ENV=dev                       # dev | test | prod
APP_NAME=Matrimony
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://matri:matri@localhost:5433/matrimony
REDIS_URL=redis://localhost:6379/0

# --- Secrets ---
# Leave these commented out for LOCAL DEV: built-in dev-only defaults are used.
# For staging/prod you MUST set real values (the app refuses to start in prod otherwise).
#   JWT_SECRET / PHONE_HASH_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   DATA_ENC_KEY (32 bytes):      python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# WARNING: never change DATA_ENC_KEY / PHONE_HASH_KEY once real users exist, or stored
# phone numbers can no longer be decrypted / looked up.
# JWT_SECRET=
# PHONE_HASH_KEY=
# DATA_ENC_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

# SMS: "console" prints OTPs to the API log (dev only). "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Legal document versions recorded with each consent
TERMS_VERSION=2026-12-01
PRIVACY_VERSION=2026-12-01
