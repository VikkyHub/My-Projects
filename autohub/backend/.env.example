# --- core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://autohub:autohub@localhost:5432/autohub?sslmode=disable
# Empty = in-memory rate limiter (fine for one local API process). Production needs Redis:
#   REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- auth ---  generate each with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_HMAC_SECRET=change-me-to-another-long-random-string-32-chars
# console = print OTP in the API log (dev). msg91 = real SMS.
SMS_DRIVER=console
# Return the OTP in the API response so you can test without SMS. Refused when NODE_ENV=production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- payments ---  fake = no Razorpay account needed (use POST /v1/dev/payments/simulate)
RAZORPAY_MODE=fake
RAZORPAY_KEY_ID=rzp_fake_local
RAZORPAY_KEY_SECRET=fake_secret_for_local_dev
RAZORPAY_WEBHOOK_SECRET=fake_webhook_secret

# --- marketplace economics (basis points) ---
GST_ON_COMMISSION_BPS=1800
TCS_BPS=100
TDS_194O_BPS=10
SERVICE_EARNING_HOLD_HOURS=48
